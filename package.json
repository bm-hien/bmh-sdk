{
  "name": "@bmh/bot",
  "version": "0.1.0",
  "description": "Typed Telegram Bot SDK for BMH code, Visual Flow, webhooks, and local polling.",
  "license": "MIT",
  "author": "BMH",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bm-hien/bmh-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/bm-hien/bmh-sdk/issues"
  },
  "homepage": "https://bm-hien.github.io/bmh-docs/#/telegram/overview",
  "keywords": [
    "bmh",
    "bot",
    "telegram",
    "telegram-bot-api",
    "typescript",
    "webhook",
    "polling",
    "visual-flow"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
